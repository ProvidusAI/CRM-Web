NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Optional for private dataset reads.
SANITY_API_READ_TOKEN=

# Used by /api/revalidate for Sanity webhooks.
SANITY_REVALIDATE_SECRET=

# Resend email delivery.
RESEND_API_KEY=
# The domain in RESEND_FROM_EMAIL must be verified in Resend.
RESEND_FROM_EMAIL="ProvidusCRM <connect@providuscrm.co.uk>"
CONTACT_FORM_TO_EMAIL=connect@providuscrm.co.uk
SERVICE_FORM_TO_EMAIL=connect@providuscrm.co.uk

# HubSpot. Without the portal ID the tracking script is not rendered; without a
# form GUID that form's submissions are not forwarded. Both degrade silently.
# All four values appear in a form's embed code (Forms > form > Embed).
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# Data-hosting region, e.g. na2 or eu1. Optional — the unprefixed HubSpot hosts
# redirect to the right region, so this only saves a round trip per page load.
NEXT_PUBLIC_HUBSPOT_REGION=
# Field names in each route must match that form's fields exactly; HubSpot drops
# unknown ones silently rather than erroring.
HUBSPOT_CONTACT_FORM_GUID=
HUBSPOT_SERVICE_FORM_GUID=
